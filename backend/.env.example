# CampusAI Backend Configuration
APP_ENV="development"

# SQLite database file path (initial local persistence)
SQLITE_DB_PATH="./campusai.db"

# Directory for storing uploaded PDF files
UPLOAD_DIR="./uploads"

# Maximum allowed PDF upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Initial development administrator credentials (set real values in backend/.env)
# To change the admin password later without editing code, update ADMIN_PASSWORD (or ADMIN_PASSWORD_HASH) in backend/.env and restart, or call POST /api/auth/change-password.
ADMIN_EMAIL="admin@campusai.com"
ADMIN_PASSWORD="SET_DEV_ADMIN_PASSWORD"
ADMIN_PASSWORD_HASH=""
ADMIN_FULL_NAME="CampusAI Administrator"

# Session signing secret and lifetime
AUTH_SECRET_KEY="CHANGE_TO_A_RANDOM_LONG_SECRET"
SESSION_TTL_HOURS=24

# Gemini AI API key for POST /api/chat (set your key in backend/.env, never commit secrets)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Future Phase Migration Placeholders (Supabase)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
